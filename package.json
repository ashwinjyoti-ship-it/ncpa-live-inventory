{
  "name": "ncpa-crew-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Crew stocktake app for NCPA sound inventory — Cloudflare Pages + D1",
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB=ncpa-crew-stocktake-db --local --ip 0.0.0.0 --port 8788",
    "deploy": "wrangler pages deploy public --project-name ncpa-crew-inventory",
    "db:migrate:local": "wrangler d1 migrations apply ncpa-crew-stocktake-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ncpa-crew-stocktake-db --remote",
    "db:seed:remote": "wrangler d1 execute ncpa-crew-stocktake-db --remote --file=./database/seed.sql",
    "seed:from-excel": "node scripts/build-seed-from-excel.mjs",
    "import:excel": "node scripts/import-excel-remote.mjs"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "wrangler": "^4.121.0"
  }
}
